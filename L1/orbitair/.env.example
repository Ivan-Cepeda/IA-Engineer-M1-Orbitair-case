# Copia este archivo como .env y completa los valores.
# .env NUNCA se sube al repositorio (está en .gitignore); .env.example sí.

# 1 = modo simulado (no llama a ninguna API, no gasta dinero). 0 = APIs reales.
# La tokenización con tiktoken es REAL en ambos modos.
ORBITAIR_MOCK=1

OPENAI_API_KEY=pon-aqui-tu-api-key
ANTHROPIC_API_KEY=pon-aqui-tu-api-key
# Gemini: crear la key en https://aistudio.google.com/apikey (tiene tier gratuito)
GEMINI_API_KEY=pon-aqui-tu-api-key

# Modelos por defecto del hands-on (tienen que existir en pricing.json)
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-haiku-4-5
GEMINI_MODEL=gemini-3.1-flash-lite

# Gemini 3.x "piensa" antes de responder: minimal | low | medium | high (vacío = default del modelo).
# Los tokens de thinking se COBRAN como output y CONSUMEN max_tokens.
GEMINI_THINKING_LEVEL=minimal

# Parámetros de sampling por defecto (clasificación/atención = tarea NO creativa)
ORBITAIR_TEMPERATURE=0.2
ORBITAIR_MAX_TOKENS=300

# Solo modo mock: probabilidad (0 a 1) de simular un 429 en cada llamada (Paso 3b / Paso 4)
ORBITAIR_MOCK_FAIL_RATE=0
